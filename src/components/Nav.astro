---
import { NAV_LINKS } from '@data/site';
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import brandIcon from '@assets/bluebubbles-icon.png';

interface Props {
  path: string;
}
const { path } = Astro.props;
---

<header
  class="sticky top-0 z-40 border-b border-line bg-page/85 backdrop-blur-md supports-[backdrop-filter]:bg-page/70"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a
      href="/"
      class="flex items-center gap-2 text-lg font-extrabold tracking-tight text-strong
             focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      {/* The real app icon from the server repo's icons/regular set, rather than
          a bubble drawn here. It is the brand mark: a blue bubble with three
          dots, and it carries its own colour, so no tinting container. */}
      <Image
        src={brandIcon}
        alt=""
        aria-hidden="true"
        width={28}
        height={28}
        densities={[1, 2]}
        class="size-7 shrink-0"
      />
      BlueBubbles
    </a>

    <div class="flex items-center gap-1">
      <!-- Desktop -->
      <nav aria-label="Main" class="hidden md:flex md:items-center md:gap-1">
        {NAV_LINKS.map((link) => <NavLink {...link} currentPath={path} />)}
      </nav>

      <ThemeToggle />

      <!-- Mobile: a native disclosure widget.
           <details>/<summary> gives real semantics, keyboard activation and
           aria-expanded for free, and works with JS disabled. The old site
           used a div with onclick and no semantics at all. -->
      <details
        class="relative md:hidden [&[open]_.i-closed]:hidden [&:not([open])_.i-open]:hidden"
      >
        <summary
          class="grid cursor-pointer list-none place-items-center rounded-md p-2 text-base
                 [&::-webkit-details-marker]:hidden
                 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          aria-label="Toggle navigation menu"
        >
          <Icon name="lucide:menu" class="i-closed size-6" />
          <Icon name="lucide:x" class="i-open size-6" />
        </summary>
        <nav
          aria-label="Main"
          class="absolute right-0 top-full z-50 mt-2 w-56 rounded-card border border-line
                 bg-page p-2 shadow-xl"
        >
          <ul class="flex flex-col">
            {
              NAV_LINKS.map((link) => (
                <li>
                  <NavLink {...link} currentPath={path} class="block" />
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Progressive enhancement only -- open/close already works natively.
  const menu = document.querySelector<HTMLDetailsElement>('header details');
  if (menu) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
