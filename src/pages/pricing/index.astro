---
/*
 * BlueBubbles Pro pricing.
 *
 * NOT PUBLIC YET. This route exists so that https://bluebubbles.app/pricing
 * resolves for Creem's validation. It is deliberately undiscoverable:
 *   - not in NAV_LINKS or FOOTER_LINKS, so nothing on the site links to it;
 *   - noindex, so it stays out of search results if the URL leaks;
 *   - excluded from the sitemap in astro.config.mjs.
 *
 * It is not listed in robots.txt on purpose -- a Disallow rule would publish
 * the path to anyone who reads the file, which is the opposite of hiding it.
 *
 * To launch: add it to NAV_LINKS and/or FOOTER_LINKS in src/data/site.ts, drop
 * the `noindex` below, and remove the sitemap exclusion.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import MacOSPicker from '@components/MacOSPicker.astro';
import { PLANS, PRO_FEATURES, FREE_FEATURES, MACOS_RELEASES } from '@data/pricing';
import { LINKS } from '@data/site';

// Default the picker to the newest release, so the list opens on the full
// feature set. Derived from the data rather than hardcoded, so adding macOS 27
// to MACOS_RELEASES moves the default automatically.
const newestMacOS = MACOS_RELEASES.reduce((a, b) => (b.version > a.version ? b : a));
---

<BaseLayout
  title="BlueBubbles Pro - Pricing"
  description="Pricing for BlueBubbles Pro."
  path="/pricing/"
  noindex
>
  <PageHeader
    title="BlueBubbles Pro"
    lead="Support continued development and unlock BlueBubbles Pro. Choose the plan that suits you."
  />

  <div class="mx-auto max-w-5xl px-5 py-12">
    <ul class="grid gap-5 md:grid-cols-3">
      {
        PLANS.map((plan) => (
          <li
            class:list={[
              'relative flex flex-col rounded-card border bg-raised p-6',
              plan.featured ? 'border-accent shadow-lg' : 'border-line',
            ]}
          >
            {plan.featured && (
              <span class="absolute -top-3 left-6 rounded-full bg-accent-solid px-3 py-1 text-xs font-semibold text-white">
                Best value
              </span>
            )}

            <h2 class="text-lg font-semibold text-strong">{plan.name}</h2>

            <p class="mt-4 flex items-baseline gap-1">
              <span class="text-4xl font-extrabold tracking-tight text-strong">${plan.price}</span>
              {plan.cadence && <span class="text-sm font-medium text-muted">{plan.cadence}</span>}
            </p>

            {plan.note && <p class="mt-1 text-sm font-medium text-accent">{plan.note}</p>}

            <p class="mt-4 text-sm text-muted">{plan.description}</p>
          </li>
        ))
      }
    </ul>

    <section class="mt-14">
      <h2 class="text-2xl font-bold tracking-tight text-strong">What Pro unlocks</h2>
      <p class="mt-2 max-w-2xl text-muted">
        Pro features run through the Private API on your own server Mac. Each one needs a
        minimum macOS version, shown alongside it.
      </p>

      <div class="mt-6">
        <MacOSPicker label="Your server Mac runs" noun="Pro features">
          <Fragment slot="summary">
            {PRO_FEATURES.filter((f) => f.macos <= newestMacOS.version).length} of {
              PRO_FEATURES.length
            } Pro features run on {newestMacOS.name} ({newestMacOS.version}).
          </Fragment>
        </MacOSPicker>
      </div>

      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          PRO_FEATURES.map((feature) => (
            <li
              data-feature
              data-macos={feature.macos}
              data-state={feature.macos <= newestMacOS.version ? 'included' : 'excluded'}
              class="rounded-card border border-line bg-raised p-5 transition
                     data-[state=included]:border-accent data-[state=included]:bg-accent-solid/5
                     data-[state=excluded]:opacity-55"
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-semibold text-strong">{feature.title}</h3>
                <span class="shrink-0 rounded-full border border-line px-2 py-0.5 text-xs font-medium text-muted">
                  macOS {feature.macos}+
                </span>
              </div>
              <p class="mt-2 text-sm text-muted">{feature.summary}</p>
              {/* Text, not just colour: the state has to survive greyscale and a
                  screen reader. Rendered server-side for the default selection,
                  so this is correct before the script runs and without it. */}
              <p
                data-verdict
                class:list={[
                  'mt-3 text-xs font-semibold',
                  feature.macos <= newestMacOS.version ? 'text-accent' : 'text-muted',
                ]}
              >
                {feature.macos <= newestMacOS.version ? '✓ Supported' : `Needs macOS ${feature.macos}`}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 rounded-card border border-line bg-raised p-6">
      <h2 class="text-base font-semibold text-strong">What stays free</h2>
      <p class="mt-2 text-sm text-muted">
        Pro adds to BlueBubbles; it does not take anything away. These Private API features
        remain free for everyone, as they always have been:
      </p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          FREE_FEATURES.map((name) => (
            <li class="rounded-full border border-line bg-page px-3 py-1 text-xs font-medium text-muted">
              {name}
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-12 rounded-card border border-line bg-raised p-6">
      <h2 class="text-base font-semibold text-strong">How billing works</h2>
      <p class="mt-2 text-sm text-muted">
        Purchases are handled by <a
          href="https://www.creem.io"
          rel="noopener"
          class="font-medium text-accent underline underline-offset-2">Creem</a
        > and managed by your BlueBubbles Server. Your subscription is not tied to the Google
        Play, Microsoft, Snap, or Flathub listing, so it applies wherever you use BlueBubbles.
      </p>
      <p class="mt-3 text-sm text-muted">
        Questions? Ask us on <a
          href={LINKS.discord}
          rel="noopener"
          class="font-medium text-accent underline underline-offset-2">Discord</a
        >.
      </p>
    </div>
  </div>
</BaseLayout>
