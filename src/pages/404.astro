---
import BaseLayout from '@layouts/BaseLayout.astro';
import { LINKS } from '@data/site';

// NOTE: this is the org site's 404, so GitHub Pages serves it for any
// unmatched path on bluebubbles.app -- including under /web/, which is a
// separate repo's Pages deploy. Keep the copy generic and do not redirect.
---

<BaseLayout
  title="Page not found - BlueBubbles"
  description="That page could not be found."
  path="/404"
  noindex
>
  <div class="mx-auto flex max-w-2xl flex-col items-center px-5 py-24 text-center">
    <p class="text-7xl font-extrabold tracking-tight text-accent">404</p>
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-strong sm:text-4xl">
      We couldn't find that page.
    </h1>
    <p class="mt-4 text-muted">
      The link may be out of date, or the page may have moved.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="rounded-full bg-accent-solid px-6 py-3 text-sm font-semibold text-white transition
               hover:bg-accent-solid-hover focus-visible:outline-2 focus-visible:outline-offset-2
               focus-visible:outline-accent">Go home</a
      >
      <a
        href="/downloads/"
        class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-strong transition
               hover:border-accent hover:text-accent focus-visible:outline-2
               focus-visible:outline-offset-2 focus-visible:outline-accent">Downloads</a
      >
      <a
        href="/faq/"
        class="rounded-full border border-line px-6 py-3 text-sm font-semibold text-strong transition
               hover:border-accent hover:text-accent focus-visible:outline-2
               focus-visible:outline-offset-2 focus-visible:outline-accent">FAQ</a
      >
    </div>

    <p class="mt-10 text-sm text-muted">
      Still stuck? Ask us on <a
        href={LINKS.discord}
        rel="noopener"
        class="font-medium text-accent underline underline-offset-2">Discord</a
      >.
    </p>
  </div>
</BaseLayout>
